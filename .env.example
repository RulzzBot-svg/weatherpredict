# Weather Kalshi paper bot
PAPER_BANKROLL=1000
STAKE_NOTIONAL=10
MIN_EDGE=0.08
LOOP_INTERVAL_SECONDS=300
AUTO_BET=true

# Cities: NYC | CHI | MIA | LAX | comma list | ALL
CITY=ALL

# Optional series override (only used when CITY is a single city)
# KALSHI_SERIES=KXHIGHNY

# Target date: today | tomorrow | YYYY-MM-DD
TARGET_DATE=tomorrow

# Durable paper ledger (use /var/data/... on Render disk)
STATE_PATH=data/paper_book.json

# Open-Meteo ensemble for forecast distribution
FORECAST_PROVIDER=open_meteo_ensemble
